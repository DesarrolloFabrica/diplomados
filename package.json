{
  "name": "plataforma-formacion-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w frontend",
    "lint": "npm run lint -w frontend",
    "typecheck": "npm run typecheck -w frontend && npm run typecheck -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:migrate:production": "npm run db:migrate:production -w backend",
    "db:check:production": "npm run db:check:production -w backend",
    "db:migrations:status": "npm run db:migrations:status -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:seed:production": "npm run db:seed:production -w backend",
    "db:studio": "npm run db:studio -w backend"
  }
}
