# ─────────────────────────────────────────────────────────────
# Base de datos (Cloud SQL for PostgreSQL)
# ─────────────────────────────────────────────────────────────

# Conexión de la APP en tiempo de ejecución (rol app_user, sujeto a RLS).
# Local/dev: TCP normal (vía Cloud SQL Auth Proxy o Postgres local).
DATABASE_URL=postgresql://app_user:CAMBIA_ESTA_CLAVE@localhost:5432/plataforma_formacion

# Conexión PRIVILEGIADA solo para `npm run db:migrate` (dueño del esquema,
# NO es la que usa la app). En Cloud SQL suele ser el usuario admin
# (p. ej. postgres) que gcloud crea junto con la instancia.
MIGRATIONS_DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/plataforma_formacion

# Solo se usan en Cloud Run (además de INSTANCE_CONNECTION_NAME, que ahí
# viene fijado en el propio despliegue): conexión por socket unix a
# Cloud SQL, rol app_user.
# INSTANCE_CONNECTION_NAME=PROYECTO:REGION:INSTANCIA
# DB_USER=app_user
# DB_PASSWORD=
# DB_NAME=plataforma_formacion

# ─────────────────────────────────────────────────────────────
# Autenticación propia (JWT + cookie httpOnly)
# ─────────────────────────────────────────────────────────────

# Secreto para firmar los JWT de sesión. Genera uno único y largo:
#   openssl rand -base64 48
JWT_SECRET=

# URL base de la app (enlaces de recuperación de contraseña).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Almacenamiento de archivos (Google Cloud Storage)
# ─────────────────────────────────────────────────────────────

# Bucket privado único (carpetas: portadas/, recursos/, videos/, avatares/).
GCS_BUCKET=

# Sin credenciales explícitas: en Cloud Run se usa la cuenta de servicio
# del servicio (Application Default Credentials). En local, autentica con
# `gcloud auth application-default login` o define GOOGLE_APPLICATION_CREDENTIALS
# apuntando a un archivo de llave de servicio.
# GOOGLE_APPLICATION_CREDENTIALS=

# ─────────────────────────────────────────────────────────────
# Correo transaccional (SendGrid)
# ─────────────────────────────────────────────────────────────

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-responder@tudominio.com
